# U-M GPT Toolkit, NOT an OpenAI platform/Codex credential.
# Copy to pipeline/.env only if .env does not already exist; otherwise merge these lines.
# Add the key locally or in the hosting secret manager. Never commit the completed file.
CONTACT_EMAIL=yourname@umich.edu
OPENAI_API_KEY=replace-with-your-um-toolkit-key
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.toolkit.umgpt.umich.edu/v1
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
