# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# Your real, monitored email. It goes into the User-Agent of every web request so a
# website (the SEC requires this) can contact us if our tool misbehaves.
CONTACT_EMAIL=yourname@umich.edu

# Optional: keep the database and downloaded files somewhere other than pipeline/data
# BLOOMFIELD_DATA_DIR=/some/other/folder

# ---- Part B (the AI reader and scout) ----
# Every AI step (reader, scout, summaries) uses the OpenAI Codex API and OPENAI_API_KEY by default. In code this is
# os.environ["OPENAI_API_KEY"] (the same as process.env.OPENAI_API_KEY in Node). Put your real key here.
OPENAI_API_KEY=your-openai-api-key-here
# Which AI service to use: openai_responses (the Codex API, default), openai_compatible, anthropic or gemini
# LLM_PROVIDER=openai_responses
# Codex model names (see config/reader.yaml; verify with python -m llm.check):
# LLM_MODEL_CHEAP=
# LLM_MODEL_STRONG=
# Your API key. NEVER commit it or paste it into chat.
# (ANTHROPIC_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY or OPENAI_API_KEY also work, matching the provider.)
# LLM_API_KEY=            (works for any provider; OPENAI_API_KEY above is checked first)
# Only for openai_compatible: the service address, e.g. https://api.openai.com/v1
# LLM_BASE_URL=
# Optional: override the model names in config/reader.yaml without editing it
# LLM_MODEL_CHEAP=
# LLM_MODEL_STRONG=

# ---- The web bot (optional): a licensed search service so it can find pages by searching ----
# Also set  search.provider: brave  in config/bot.yaml. Without a key the bot uses only the sites and feeds you list.
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
